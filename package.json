{
  "name": "Openlytic.Backend.Service.Email",
  "version": "1.0.0",
  "description": "Openlytic email send consumer - reads app_queue send_email rows and delivers via Amazon SES",
  "main": "dist/index.js",
  "author": "Openlytic",
  "license": "ISC",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint --quiet . --ignore-pattern build/ --ignore-pattern dist/",
    "lint-fix": "eslint --quiet . --fix --ignore-pattern build/ --ignore-pattern dist/",
    "format": "prettier . --write",
    "invoke": "tsx src/invoke.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js",
    "pre-commit": "lint-staged --allow-empty",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.700.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "esbuild": "^0.23.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "husky": "^9.1.5",
    "lint-staged": "^15.2.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,css,scss,json,html,graphql}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
